## <summary>Run bubblewrap and then transition back to original domain</summary>

# SPDX-FileCopyrightText: (c) 2025-2026 Russell Coker <russell@coker.com.au>
# SPDX-FileCopyrightText: (c) 2026 Daniel Hast
#
# SPDX-License-Identifier: GPL-2.0-or-later

# Adapted from the bubblewrap module in SELinux Reference Policy:
# https://github.com/SELinuxProject/refpolicy/blob/95340c3594090f4f70a26aab3d84d057cdb3e8bd/policy/modules/apps/bubblewrap.if

########################################
## <summary>
##	Role access for bubblewrap.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role (e.g., user
##	is the prefix for user_r).
##	</summary>
## </param>
## <param name="user_domain">
##	<summary>
##	User domain for the role.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access
##	</summary>
## </param>
template(`bubblewrap_role',`
	gen_require(`
		attribute bubblewrap_domain;
		attribute_role bubblewrap_roles;
		type bubblewrap_exec_t;

		type bin_t;
		type lib_t;
		type sysctl_t;
		type var_lib_t;
	')

	type $1_bubblewrap_t;
	typeattribute $1_bubblewrap_t bubblewrap_domain;

	roleattribute $3 bubblewrap_roles;
	role $3 types { $1_bubblewrap_t };

	# Transition from user domain to bubblewrap domain
	application_domain($1_bubblewrap_t, bubblewrap_exec_t)
	domtrans_pattern($2, bubblewrap_exec_t, $1_bubblewrap_t)

	# Execute bubblewrap in bubblewrap domain
	bubblewrap_exec($1_bubblewrap_t)

	# Transition from bubblewrap domain back to user domain
	corecmd_bin_domtrans($1_bubblewrap_t, $2)
	corecmd_shell_domtrans($1_bubblewrap_t, $2)
	userdom_domtrans_user_home($1_bubblewrap_t, $2)
	userdom_domtrans_user_tmp($1_bubblewrap_t, $2)
	bubblewrap_command_domtrans($1, lib_t, $2)
	bubblewrap_command_domtrans($1, var_lib_t, $2)
	domain_entry_file_spec_domtrans($1_bubblewrap_t, $2)
	allow $1_bubblewrap_t $2:process { noatsecure rlimitinh siginh };
	allow $1_bubblewrap_t $2:process2 { nnp_transition nosuid_transition };

	allow $1_bubblewrap_t $2:fd use;
	allow $2 $1_bubblewrap_t:fd use;

	allow $1_bubblewrap_t $2:unix_stream_socket rw_socket_perms;

	allow $2 $1_bubblewrap_t:process signal_perms;
	ps_process_pattern($1_bubblewrap_t, $2)

	allow $1_bubblewrap_t self:process { sigkill setpgid getcap setcap };
	allow $1_bubblewrap_t self:user_namespace create;
	allow $1_bubblewrap_t self:cap_userns { dac_override dac_read_search net_admin setpcap sys_admin sys_ptrace sys_resource };
	allow $1_bubblewrap_t self:netlink_route_socket create_netlink_socket_perms;

	allow $1_bubblewrap_t self:udp_socket create;
	allow $1_bubblewrap_t self:unix_dgram_socket { create ioctl };

	kernel_mount_proc($1_bubblewrap_t)
	kernel_read_sysctl($1_bubblewrap_t)
	kernel_read_kernel_sysctls($1_bubblewrap_t)
	kernel_read_system_state($1_bubblewrap_t)
	rw_files_pattern($1_bubblewrap_t, sysctl_t, sysctl_t)

	dev_getattr_all_blk_files($1_bubblewrap_t)
	dev_getattr_all_chr_files($1_bubblewrap_t)
	dev_read_rand($1_bubblewrap_t)
	dev_remount_sysfs_fs($1_bubblewrap_t)
	dev_rw_dma_dev($1_bubblewrap_t)
	dev_dontaudit_rw_dri($1_bubblewrap_t)

	domain_use_interactive_fds($1_bubblewrap_t)

	files_list_home($1_bubblewrap_t)
	files_list_non_security($1_bubblewrap_t)
	files_getattr_all_files($1_bubblewrap_t)
	files_getattr_all_chr_files($1_bubblewrap_t)
	files_getattr_all_sockets($1_bubblewrap_t)
	files_mounton_non_security($1_bubblewrap_t)
	files_read_all_symlinks($1_bubblewrap_t)
	files_read_etc_files($1_bubblewrap_t)
	files_read_var_lib_files($1_bubblewrap_t)
	files_search_mnt($1_bubblewrap_t)

	fs_read_nsfs_files($1_bubblewrap_t)
	fs_list_auto_mountpoints($1_bubblewrap_t)
	fs_manage_tmpfs_dirs($1_bubblewrap_t)
	fs_mount_tmpfs($1_bubblewrap_t)
	fs_remount_all_fs($1_bubblewrap_t)
	fs_unmount_tmpfs($1_bubblewrap_t)
	fs_unmount_xattr_fs($1_bubblewrap_t)

	selinux_get_fs_mount($1_bubblewrap_t)
	selinux_remount_fs($1_bubblewrap_t)

	term_getattr_unallocated_ttys($1_bubblewrap_t)
	term_mount_pty_fs($1_bubblewrap_t)

	miscfiles_read_localization($1_bubblewrap_t)

	userdom_list_user_tmp($1_bubblewrap_t)
	userdom_manage_tmp_role($3, $1_bubblewrap_t)
	userdom_read_user_tmp_symlinks($1_bubblewrap_t)
	userdom_manage_all_user_home_type_dirs($1_bubblewrap_t)
	userdom_manage_all_user_home_type_files($1_bubblewrap_t)
	userdom_manage_user_home_content_symlinks($1_bubblewrap_t)
	userdom_use_user_ptys($1_bubblewrap_t)
	userdom_use_user_ttys($1_bubblewrap_t)

	ifndef(`enable_mls',`
		fs_search_removable($1_bubblewrap_t)
		fs_read_removable_files($1_bubblewrap_t)
		fs_read_removable_symlinks($1_bubblewrap_t)
	')

	tunable_policy(`use_nfs_home_dirs',`
		fs_read_nfs_symlinks($1_bubblewrap_t)
	')

	tunable_policy(`use_samba_home_dirs',`
		fs_read_cifs_symlinks($1_bubblewrap_t)
	')

	optional_policy(`
		thumb_run($1_bubblewrap_t, $3)
	')

	optional_policy(`
		gen_require(`
			type data_home_t;
		')
		bubblewrap_command_domtrans($1, data_home_t, $2)
	')

	optional_policy(`
		gen_require(`
			type flatpak_home_t;
		')
		bubblewrap_command_domtrans($1, flatpak_home_t, $2)
	')
')

########################################
## <summary>
##	Allow no-new-privileges transition to bubblewrap domain.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role (e.g., user
##	is the prefix for user_r).
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
#
interface(`bubblewrap_nnp_domtrans',`
	gen_require(`
		type $1_bubblewrap_t;
	')

	allow $2 $1_bubblewrap_t:process2 { nnp_transition nosuid_transition };
')

########################################
## <summary>
##	Allow domain to execute a given bubblewrap domain
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role (e.g., user
##	is the prefix for user_r).
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`bubblewrap_domtrans',`
	gen_require(`
		type $1_bubblewrap_t;
		type bubblewrap_exec_t;
	')

	domtrans_pattern($2, bubblewrap_exec_t, $1_bubblewrap_t)
')

########################################
## <summary>
##	Allow bubblewrap to execute a given file type with a transition to
##	a given domain.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role (e.g., user
##	is the prefix for user_r).
##	</summary>
## </param>
## <param name="entry_point">
##	<summary>
##	File type bubblewrap can execute.
##	</summary>
## </param>
## <param name="target_domain">
##	<summary>
##	Target bubblewrap transitions to when executing the given file type.
##	</summary>
## </param>
#
interface(`bubblewrap_command_domtrans',`
	gen_require(`
		type $1_bubblewrap_t;
	')

	allow $3 $2:file { entrypoint lock mmap_exec_file_perms };
	domtrans_pattern($1_bubblewrap_t, $2, $3)
	allow $1_bubblewrap_t $3:process2 { nnp_transition nosuid_transition };
')

########################################
## <summary>
##	Execute bubblewrap in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`bubblewrap_exec',`
	gen_require(`
		type bin_t;
		type bubblewrap_exec_t;
	')

	corecmd_search_bin($1)
	getattr_files_pattern($1, bin_t, bubblewrap_exec_t)
	can_exec($1, bubblewrap_exec_t)
')
